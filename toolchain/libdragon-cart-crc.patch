+/* Verified read: fetch twice and compare, retrying on disagreement.
+ *
+ * The transfer above collects each sector's 8 CRC bytes and discards them, so
+ * a corrupted sector is handed up looking exactly like a good one. On some
+ * cards that is invisible; on others it is not. Observed on an EverDrive 64
+ * X7: a root directory that enumerated ten correct entries on one boot and
+ * three entries named '?' on the next, a file whose length read back as zero
+ * six times out of seven, and the same filename resolving under two different
+ * spellings on consecutive attempts -- all from identical code and an
+ * unchanged card.
+ *
+ * Verifying the CRC properly means un-interleaving four bit-planes and running
+ * four CRC16s over every sector, which is both intricate and not free. Reading
+ * twice and comparing catches the same class of fault for a few lines, and
+ * costs bandwidth only where it is applied.
+ *
+ * It is applied to small reads only. Those are the filesystem's metadata --
+ * directory entries, FAT chains -- where a single wrong byte turns into a
+ * missing file, and where the doubled traffic is irrelevant. Bulk reads pass
+ * through unverified: they are streamed data, they are the bandwidth that
+ * matters, and a corrupt sample is a click rather than a lost file.
+ */
+#define EDX_VERIFY_MAX_SECTORS 8
+#define EDX_VERIFY_ATTEMPTS    4
+
+int edx_card_rd_dram(void *dram, uint32_t lba, uint32_t count)
+{
+    static uint8_t verify_buf[EDX_VERIFY_MAX_SECTORS * 512]
+        __attribute__((aligned(16)));
+
+    if (count == 0 || count > EDX_VERIFY_MAX_SECTORS)
+        return __edx_card_rd_dram_raw(dram, lba, count);
+
+    const uint32_t bytes = count * 512;
+
+    for (int attempt = 0; attempt < EDX_VERIFY_ATTEMPTS; attempt++)
+    {
+        if (__edx_card_rd_dram_raw(dram, lba, count) < 0) continue;
+        if (__edx_card_rd_dram_raw(verify_buf, lba, count) < 0) continue;
+
+        uint32_t i = 0;
+        while (i < bytes && ((uint8_t *)dram)[i] == verify_buf[i]) i++;
+        if (i == bytes) return 0;          /* both passes agree */
+    }
+
+    /* Never agreed. Returning the last read would pass corruption upward as
+     * though it were sound, which is the behaviour this exists to stop. */
+    return -1;
+}
